<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+ package visibility: without this the app can't see the
         installed text-to-speech engine, and the 🔊 pronunciation button
         silently does nothing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Weekly-word notifications. POST_NOTIFICATIONS is requested at
         runtime (Week tab / Settings); the others keep the two daily
         alarms firing on time through Doze and reboots. USE_EXACT_ALARM is
         granted automatically on 13+; older versions fall back to inexact. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Only used to look up a definition when a word is added from another
         app ("Add to Voquab"). Everything else is offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.App"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.App.Main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Morning / evening weekly-word checks. Boot and package-replaced
             are listened for because both wipe AlarmManager. -->
        <receiver
            android:name=".weekly.WeeklyAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "I used it" / "Swap word" buttons on notifications. -->
        <receiver
            android:name=".weekly.WeeklyActionReceiver"
            android:exported="false" />

        <!-- Daily quiz alarms and the quiz answer buttons. -->
        <receiver
            android:name=".learning.QuizReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- "Add to Voquab" in other apps' text-selection menu (PROCESS_TEXT)
             and the share sheet. Transparent: just a small dialog. -->
        <activity
            android:name=".capture.AddWordActivity"
            android:exported="true"
            android:label="@string/add_word_label"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.App.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Home-screen widgets. -->
        <receiver
            android:name=".widget.WordWidgetReceiver"
            android:exported="true"
            android:label="@string/word_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/word_widget_info" />
        </receiver>
        <receiver
            android:name=".widget.WeeklyWidgetReceiver"
            android:exported="true"
            android:label="@string/weekly_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weekly_widget_info" />
        </receiver>

    </application>

</manifest>
