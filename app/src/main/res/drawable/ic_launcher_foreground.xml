<?xml version="1.0" encoding="utf-8"?>
<!--
    Voquab glyph: a speech bubble (words are for saying) with a "V" cut
    through it. One even-odd path, so the V is a hole rather than a second
    colour: on the launcher the dark background shows through, and as a
    notification small icon (which only uses alpha) it still reads as a V.

    Drawn inside the central ~52x50 of the 108x108 adaptive-icon viewport,
    well within the safe zone so circle/squircle masks never clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M38,30 h32 a10,10 0 0 1 10,10 v20 a10,10 0 0 1 -10,10 h-22 l-12,10 l2,-10 a10,10 0 0 1 -10,-10 v-20 a10,10 0 0 1 10,-10 z
            M40,40 L46.5,40 L54,51.5 L61.5,40 L68,40 L54,61 z" />
</vector>
